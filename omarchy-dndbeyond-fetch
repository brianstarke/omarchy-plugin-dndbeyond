# entry
# --------------------------------------------------------------------------

def emit(payload):
    json.dump(payload, sys.stdout)
    sys.stdout.write("\n")
    sys.exit(0)


def fail(state, message):
    json.dump({"state": state, "message": str(message)}, sys.stdout)
    sys.stdout.write("\n")
    sys.exit(1)


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if len(argv) >= 2 else 1
    command = argv[1]

    if command == "_parse":
        char = json.load(sys.stdin)
        emit({"state": "ok", "message": "", "sheet": transform_character(char)})

    if command in ("sheet", "_raw") and len(argv) < 3:
        fail("error", "usage: omarchy-dndbeyond-fetch %s <character-id>" % command)
    if command == "rest" and len(argv) < 4:
        fail("error", "usage: omarchy-dndbeyond-fetch rest short|long <character-id>")
    if command == "select" and len(argv) < 3:
        fail("error", "usage: omarchy-dndbeyond-fetch select <character-id>")
    if command not in ("list", "sheet", "_raw", "rest", "select", "auth-check"):
        fail("error", "unknown command %r — try --help" % command)

    cfg = load_config()
    if command == "select":
        cmd_select(argv[2])
    token = get_token(cfg)
    if command == "list":
        extra = ""
        if "--extra-ids" in argv:
            pos = argv.index("--extra-ids")
            if pos + 1 < len(argv):
                extra = argv[pos + 1]
        cmd_list(cfg, token, extra)
    elif command == "sheet":
        cmd_sheet(cfg, token, argv[2])
    elif command == "_raw":
        url = "%s/character/v5/character/%s?includeCustomItems=true" % (CHARACTER_SERVICE, argv[2])
        emit(unwrap(http_json(url, headers=bearer(token))))
    elif command == "rest":
        cmd_rest(cfg, token, argv[2], argv[3])
    else:
        cmd_auth_check(cfg, token)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except KeyboardInterrupt:
        fail("error", "interrupted")
    except Exception as exc:  # last resort: still emit JSON the panel can read
        fail("error", "%s: %s" % (type(exc).__name__, exc))
